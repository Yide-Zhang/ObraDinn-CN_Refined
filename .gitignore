# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 打包 / 中间产物（build_release.py 生成，不进库）----
build/
dist/
*.spec
out/

# ---- .NET 构建产物（langtool 探针工程、bin/obj 里的东西）----
**/bin/
**/obj/
/tests/out/

# ---- 平台预编译产物：各自 dotnet publish / 打包时现生成，不进库 ----
installer/assets/langtool/langtool
installer/assets/langtool/langtool.exe
installer/assets/langtool/langtool-macos-arm64
installer/assets/langtool/langtool-macos-x64

# ---- 游戏素材 / 原始素材（体积大，版权属游戏；构建时从玩家自己的游戏目录取）----
#     注：下面这些前面加 "/" 是**只匹配根** —— 不加的话 `assets/` 会把
#     installer/assets/（我们自己的译文表、贴图）也一起排掉（踩过）
/originalassets/
/font_src/
/olddevassets/
/weirdFonts/
/"weirdFonts/
# ⚠ 想「只忽略 assets/ 里的大文件、放行 .py」必须这么写：
#   目录级的 `/assets/` 会把后面的 `!` 全部废掉（git 不会进那个目录）——
#   2026-10-13 才发现：字体工具链（inject_fonts / make_subset_fonts / …）因此一直没进库。
#   正确写法：先 `/assets/**`，再 `!/assets/**/` 放行目录，最后放行 .py。
/assets/**
!/assets/**/
!/assets/**/*.py
/langpack/dev/
/langpack/original/
/tests/*.dll
installer/assets/lang-zh-s-official
installer/assets/sharedassets6.assets
installer/assets/fonts/A-*.otf

# ---- 运行期生成的东西 ----
*.log
*.bak
installer/out/
installer/assets/*.tmp

# ---- 会话里的临时脚本（人还在用，但不入库）----
**/_scratch_*

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
